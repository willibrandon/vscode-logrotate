{
  "name": "logrotate",
  "displayName": "Logrotate",
  "description": "Language support for logrotate configuration and state files",
  "version": "0.1.9",
  "private": true,
  "license": "MIT",
  "publisher": "willibrandon",
  "author": {
    "name": "Brandon Williams"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/willibrandon/vscode-logrotate.git"
  },
  "bugs": {
    "url": "https://github.com/willibrandon/vscode-logrotate/issues"
  },
  "homepage": "https://willibrandon.github.io/vscode-logrotate/",
  "icon": "media/icon.png",
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "logrotate",
    "configuration",
    "linux",
    "language-server"
  ],
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25",
    "vscode": "^1.102.0"
  },
  "main": "./dist/extension.cjs",
  "browser": "./dist/browser.js",
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": true,
      "description": "%capabilities.virtualWorkspaces%"
    },
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces%",
      "restrictedConfigurations": [
        "logrotate.externalValidation.mode",
        "logrotate.executablePath"
      ]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "logrotate",
        "aliases": [
          "Logrotate",
          "logrotate"
        ],
        "filenames": [
          "logrotate.conf"
        ],
        "filenamePatterns": [
          "**/logrotate.d/*",
          "**/*.logrotate",
          "**/*.logrotate.conf"
        ],
        "firstLine": "^\\s*(?:\"(?:[^\"\\\\]|\\\\.)+\"|'(?:[^'\\\\]|\\\\.)+'|(?:/|~/)(?:[^\\s{}#\\\\]|\\\\.)+)(?:\\s+(?:\"(?:[^\"\\\\]|\\\\.)+\"|'(?:[^'\\\\]|\\\\.)+'|(?:/|~/)(?:[^\\s{}#\\\\]|\\\\.)+))*\\s*\\{\\s*(?:#.*)?$",
        "configuration": "./language-configuration.json"
      },
      {
        "id": "logrotate-state",
        "aliases": [
          "Logrotate State",
          "logrotate-state"
        ],
        "filenames": [
          "logrotate.status"
        ],
        "filenamePatterns": [
          "**/logrotate/status"
        ],
        "firstLine": "^logrotate state -- version [12]$"
      }
    ],
    "grammars": [
      {
        "language": "logrotate",
        "scopeName": "source.logrotate",
        "path": "./syntaxes/logrotate.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.shell": "shellscript"
        }
      },
      {
        "language": "logrotate-state",
        "scopeName": "source.logrotate.state",
        "path": "./syntaxes/logrotate-state.tmLanguage.json"
      },
      {
        "scopeName": "source.logrotate.markdown",
        "path": "./syntaxes/logrotate-markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.logrotate": "logrotate"
        }
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "logrotate",
        "scopes": {
          "keyword": [
            "keyword.control.directive.logrotate"
          ],
          "string": [
            "string.unquoted.path.logrotate"
          ],
          "number": [
            "constant.numeric.logrotate"
          ],
          "comment": [
            "comment.line.number-sign.logrotate"
          ],
          "parameter": [
            "entity.name.user.logrotate"
          ]
        }
      }
    ],
    "snippets": [
      {
        "language": "logrotate",
        "path": "./snippets/logrotate.json"
      }
    ],
    "commands": [
      {
        "command": "logrotate.validateWithInstalledLogrotate",
        "title": "%command.validateExternal%",
        "category": "Logrotate",
        "enablement": "logrotate.externalValidationAvailable"
      },
      {
        "command": "logrotate.restartLanguageServer",
        "title": "%command.restartServer%",
        "category": "Logrotate"
      },
      {
        "command": "logrotate.showLanguageServerOutput",
        "title": "%command.showOutput%",
        "category": "Logrotate"
      },
      {
        "command": "logrotate.openDirectiveDocumentation",
        "title": "%command.openDocumentation%",
        "category": "Logrotate"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "logrotate.validateWithInstalledLogrotate",
          "when": "editorLangId == logrotate && logrotate.externalValidationAvailable"
        },
        {
          "command": "logrotate.openDirectiveDocumentation",
          "when": "editorLangId == logrotate"
        }
      ]
    },
    "configuration": {
      "title": "Logrotate",
      "properties": {
        "logrotate.validation.enable": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "%configuration.validation.enable%"
        },
        "logrotate.validation.maxProblems": {
          "type": "integer",
          "default": 100,
          "minimum": 1,
          "maximum": 1000,
          "scope": "resource",
          "description": "%configuration.validation.maxProblems%"
        },
        "logrotate.targetVersion": {
          "type": "string",
          "default": "latest",
          "enum": [
            "latest",
            "auto",
            "3.22"
          ],
          "scope": "resource",
          "description": "%configuration.targetVersion%"
        },
        "logrotate.externalValidation.mode": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "onSave"
          ],
          "scope": "resource",
          "description": "%configuration.externalValidation.mode%"
        },
        "logrotate.executablePath": {
          "type": "string",
          "default": "logrotate",
          "scope": "machine-overridable",
          "description": "%configuration.executablePath%"
        },
        "logrotate.trace.server": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "scope": "window",
          "description": "%configuration.trace.server%"
        }
      }
    }
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "generate": "node ./scripts/generate-language-data.mjs",
    "check:generated": "node ./scripts/generate-language-data.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:core": "vitest run packages/language-core/test",
    "test:lsp": "vitest run packages/language-server/test",
    "test:client": "vitest run packages/vscode-client/test",
    "test:grammar": "vitest run test/grammar",
    "test:performance": "vitest run --config vitest.performance.config.mts",
    "test:package": "vitest run test/package",
    "test:vsix": "npm run package && npm run test:vsix:prepared",
    "test:vsix:prepared": "node ./scripts/run-package-smoke.mjs",
    "test:remote": "npm run package && npm run test:remote:prepared",
    "test:remote:prepared": "node ./scripts/run-remote-ssh-smoke.mjs",
    "test:installed-logrotate": "node ./scripts/check-installed-logrotate.mjs",
    "verify:marketplace": "node ./scripts/verify-marketplace-release.mjs",
    "test:integration": "npm run build && node ./scripts/run-desktop-tests.mjs",
    "test:web": "npm run build && node ./scripts/run-web-tests.mjs",
    "capture:themes": "npm run build && node ./scripts/capture-theme-screenshots.mjs",
    "build": "node ./esbuild.mjs",
    "check:bundles": "node ./scripts/check-bundles.mjs",
    "check:licenses": "node ./scripts/check-licenses.mjs",
    "check:package": "node ./scripts/check-package.mjs",
    "check:upstream": "node ./scripts/check-upstream-drift.mjs",
    "audit": "npm audit --audit-level=moderate",
    "audit:signatures": "npm audit signatures",
    "vscode:prepublish": "npm run check:bundles",
    "package": "npm run build && npm run check:bundles && npm run check:licenses && npm run check:package && npm run package:artifacts",
    "package:artifacts": "node ./scripts/build-release-artifacts.mjs",
    "package:list": "vsce ls --no-dependencies",
    "verify": "npm run check:generated && npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run test:performance && npm run build && npm run check:bundles && npm run check:licenses && npm run check:package && npm run test:package && npm run audit && npm run audit:signatures"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "24.13.3",
    "@types/vscode": "1.102.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "4.1.10",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/test-web": "0.0.81",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "fast-check": "4.9.0",
    "glob": "13.0.6",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10",
    "vscode-jsonrpc": "9.0.1",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2",
    "yaml": "2.9.0",
    "yauzl": "3.4.0"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.0",
    "vscode-languageserver": "10.1.0",
    "vscode-languageserver-textdocument": "1.0.12",
    "vscode-uri": "3.1.0"
  },
  "overrides": {
    "cheerio": "1.0.0-rc.12",
    "diff": "8.0.3",
    "glob": "13.0.6",
    "keytar": "npm:@github/keytar@7.10.6",
    "serialize-javascript": "7.1.0"
  },
  "files": [
    "dist/extension.cjs",
    "dist/browser.js",
    "dist/nodeServer.cjs",
    "dist/browserServer.js",
    "syntaxes/",
    "snippets/",
    "media/icon.png",
    "language-configuration.json",
    "package.nls.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "SUPPORT.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "allowScripts": {
    "@playwright/browser-chromium@1.62.1": true,
    "@vscode/vsce-sign@2.0.9": true,
    "esbuild@0.28.2": true,
    "@github/keytar@7.10.6": true
  }
}
