{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Logrotate Markdown code blocks",
  "scopeName": "source.logrotate.markdown",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [
    {
      "include": "#fenced-logrotate"
    }
  ],
  "repository": {
    "fenced-logrotate": {
      "name": "markup.fenced_code.block.markdown",
      "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(logrotate|logrotate\\.conf|logrotate-config))(?:\\s+[^`~]*)?$",
      "end": "(^|\\G)(?:\\2|\\s{0,3})(\\3)\\s*$",
      "contentName": "meta.embedded.block.logrotate",
      "beginCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        },
        "4": {
          "name": "fenced_code.block.language"
        }
      },
      "endCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        }
      },
      "patterns": [
        {
          "include": "source.logrotate"
        }
      ]
    }
  }
}
